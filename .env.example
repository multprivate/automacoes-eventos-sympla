# Copie para .env e preencha com os valores reais.
# .env nunca deve ser commitado (já está no .gitignore).

# Obrigatórias
SYMPLA_TOKEN=
BITRIX_WEBHOOK_URL=

# Opcionais (Automação A) — se vazias, o comportamento default de common.py é usado
BITRIX_STAGE_INSCRITO_PRO_EVENTO=
BITRIX_FIELD_DATA_DO_EVENTO=
BITRIX_FIELD_NOME_DO_EVENTO=
BITRIX_FIELD_SYMPLA_EVENT_ID=
BITRIX_FIELD_ORIGEM=
BITRIX_FIELD_FILTRAR_EVENTO=

# Opcional (Automação B)
BITRIX_FIELD_PRESENTE_NO_EVENTO=

# Modo teste da Automação A (opcional): lista de event_id internos da
# Sympla (separados por vírgula) — quando preenchida, a automação ignora
# todos os outros eventos. Deixe vazio em produção. NÃO configurar como
# secret no GitHub Actions.
TEST_EVENT_IDS=

# Supabase (opcional pra Automação A — sem isso, cupons/mapeamento caem
# pro fallback fixo no código; OBRIGATÓRIO pro painel administrativo)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Painel administrativo (interface_app.py)
ADMIN_PASSWORD=
FLASK_SECRET_KEY=
